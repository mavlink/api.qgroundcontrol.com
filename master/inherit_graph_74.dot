  Node1 [id="Node000001",label="QGCAbstractTransition",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classQGCAbstractTransition.html",tooltip="Base class for custom transitions that need access to QGCStateMachine and Vehicle."];
  Node1 -> Node2 [id="edge69_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
