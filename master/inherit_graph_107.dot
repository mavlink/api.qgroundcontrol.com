  Node0 -> Node4 [id="edge90_Node000000_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="QSerialPort",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classQSerialPort.html",tooltip="Provides functions to access serial ports."];
