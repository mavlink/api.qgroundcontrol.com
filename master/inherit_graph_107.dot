  rankdir="LR";
  Node0 [id="Node000000",label="QIODevice",height=0.2,width=0.4,color="grey60", fillcolor="#E0E0E0", style="filled",tooltip=" "];
  Node0 -> Node1 [id="edge87_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="QGCArchiveDeviceBase",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classQGCArchiveDeviceBase.html",tooltip="Base class for QIODevice wrappers that use libarchive for decompression."];
  Node1 -> Node2 [id="edge88_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="QGCArchiveFile",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classQGCArchiveFile.html",tooltip="QIODevice for reading a single entry from an archive without full extraction."];
  Node1 -> Node3 [id="edge89_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
