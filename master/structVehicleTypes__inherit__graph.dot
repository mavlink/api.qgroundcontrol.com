  Node1 [id="Node000001",label="VehicleTypes",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip=" "];
  Node1 -> Node2 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="MavCommandQueue",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMavCommandQueue.html",tooltip="Owns the COMMAND_LONG / COMMAND_INT send/retry/ack pipeline for a single Vehicle."];
  Node1 -> Node3 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="MessageIntervalManager",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMessageIntervalManager.html",tooltip="Tracks per-component MAVLink message intervals and mediates SET_MESSAGE_INTERVAL commands plus MESSAG..."];
  Node1 -> Node4 [id="edge3_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="RequestMessageCoordinator",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classRequestMessageCoordinator.html",tooltip="Coordinates MAV_CMD_REQUEST_MESSAGE workflows: per-component queueing, ack/message correlation,..."];
  Node1 -> Node5 [id="edge4_Node000001_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="Vehicle",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classVehicle.html",tooltip=" "];
}
