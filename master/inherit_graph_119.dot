  Node1 -> Node2 [id="edge111_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="QGCState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classQGCState.html",tooltip="Full-featured base class for QGroundControl state machine states."];
  Node2 -> Node3 [id="edge112_Node000002_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="CircuitBreakerState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classCircuitBreakerState.html",tooltip="A state that implements the circuit breaker pattern."];
  Node2 -> Node4 [id="edge113_Node000002_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="ConditionalState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classConditionalState.html",tooltip="A state that evaluates a predicate on entry and either executes or skips."];
  Node2 -> Node5 [id="edge114_Node000002_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="DelayState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classDelayState.html",tooltip="Delays that state machine for the specified time in milliseconds."];
  Node2 -> Node6 [id="edge115_Node000002_Node000006",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node6 [id="Node000006",label="ErrorRecoveryState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classErrorRecoveryState.html",tooltip="The state created by ErrorRecoveryBuilder."];
  Node2 -> Node7 [id="edge116_Node000002_Node000007",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node7 [id="Node000007",label="FallbackChainState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classFallbackChainState.html",tooltip="A state that tries multiple strategies in order until one succeeds."];
  Node2 -> Node8 [id="edge117_Node000002_Node000008",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node8 [id="Node000008",label="FunctionState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classFunctionState.html",tooltip=" "];
