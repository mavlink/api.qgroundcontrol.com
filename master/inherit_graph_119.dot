  Node18 [id="Node000018",label="WaitStateBase",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classWaitStateBase.html",tooltip="Base class for states that wait for something with optional timeout."];
  Node18 -> Node19 [id="edge128_Node000018_Node000019",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node19 [id="Node000019",label="AsyncFunctionState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classAsyncFunctionState.html",tooltip="Calls a function when entered and waits for an external trigger to advance."];
  Node18 -> Node20 [id="edge129_Node000018_Node000020",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node20 [id="Node000020",label="EventQueuedState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classEventQueuedState.html",tooltip="A state that waits for one or more named events before advancing."];
  Node18 -> Node21 [id="edge130_Node000018_Node000021",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node21 [id="Node000021",label="RequestMessageState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classRequestMessageState.html",tooltip="Requests a MAVLink message from the vehicle using MAV_CMD_REQUEST_MESSAGE."];
  Node18 -> Node22 [id="edge131_Node000018_Node000022",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node22 [id="Node000022",label="RetryableRequestMessageState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classRetryableRequestMessageState.html",tooltip="Requests a MAVLink message with built-in retry logic."];
  Node18 -> Node23 [id="edge132_Node000018_Node000023",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node23 [id="Node000023",label="SendMavlinkCommandState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classSendMavlinkCommandState.html",tooltip="Sends the specified MAVLink command to the vehicle and waits for the result."];
  Node18 -> Node24 [id="edge133_Node000018_Node000024",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node24 [id="Node000024",label="SkippableAsyncState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classSkippableAsyncState.html",tooltip="Combines skip condition checking with async operation setup in a single state."];
  Node18 -> Node25 [id="edge134_Node000018_Node000025",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node25 [id="Node000025",label="WaitForMavlinkMessageState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classWaitForMavlinkMessageState.html",tooltip="Waits for the specified MAVLink message from the vehicle."];
  Node18 -> Node26 [id="edge135_Node000018_Node000026",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node26 [id="Node000026",label="WaitForParamResponseState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classWaitForParamResponseState.html",tooltip="Waits for either PARAM_VALUE (success) or PARAM_ERROR (rejection) from the vehicle."];
  Node18 -> Node27 [id="edge136_Node000018_Node000027",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node27 [id="Node000027",label="WaitForSignalState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classWaitForSignalState.html",tooltip="Waits for a signal from a QObject before advancing."];
