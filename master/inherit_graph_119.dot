  Node2 -> Node13 [id="edge122_Node000002_Node000013",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node13 [id="Node000013",label="RollbackState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classRollbackState.html",tooltip="A state that executes an action with automatic rollback on failure."];
  Node2 -> Node14 [id="edge123_Node000002_Node000014",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node14 [id="Node000014",label="SendMavlinkMessageState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classSendMavlinkMessageState.html",tooltip="Sends the specified MAVLink message to the vehicle."];
  Node2 -> Node15 [id="edge124_Node000002_Node000015",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node15 [id="Node000015",label="SequenceState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classSequenceState.html",tooltip="A composite state that executes a sequence of actions in order."];
  Node2 -> Node16 [id="edge125_Node000002_Node000016",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node16 [id="Node000016",label="ShowAppMessageState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classShowAppMessageState.html",tooltip="Display an application message to the user."];
  Node2 -> Node17 [id="edge126_Node000002_Node000017",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node17 [id="Node000017",label="SubMachineState",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classSubMachineState.html",tooltip="State that invokes a child state machine."];
